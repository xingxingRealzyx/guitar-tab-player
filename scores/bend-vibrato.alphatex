\title "推弦与颤音"
\subtitle "半音/全音推弦 + 手腕颤音"
\artist "TabDeck 练习曲"
\track "主音吉他"
\tempo 70
\instrument 30
.
// ============================================================
// 推弦（bend）与颤音（vibrato）· 慢速表情练习，tempo 70
// {b (0 1)} = 半音推弦   {b (0 2)} = 全音推弦   {v} = 手腕颤音
// 每小节 8 个八分音符，一个音一拍半的呼吸感
// 1–4   半音推弦：推到准确音高再停住，不要一推就滑过去
// 5–8   全音推弦 + 颤音：颤音要匀，用手腕不要用手指
// 9–12  预推弦（先推到音高再弹）与推弦后回放
// 13–16 实用乐句：把前三种技巧放进句子里
// 推弦的音准比速度重要：每个音都对着调音器确认过再往下
// ============================================================
// ---------- 1–4 · 半音推弦 ----------
\section "A · 半音推弦 {b (0 1)}"
:8 7.3{b (0 1)} 7.3 9.3{b (0 1)} 9.3 7.3{b (0 1)} 7.3 9.3{b (0 1)} 9.3 | :8 9.3{b (0 1)} 9.3 7.3{b (0 1)} 7.3 5.3{b (0 1)} 5.3 5.3{b (0 1)} 5.3 | :8 5.2{b (0 1)} 5.2 7.2{b (0 1)} 7.2 7.3{b (0 1)} 7.3 7.3{b (0 1)} 7.3 | :8 9.3{b (0 1)} 9.3 7.3{b (0 1)} 7.3 5.3{b (0 1)} 5.3 5.3{v} 5.3{v} |
// ---------- 5–8 · 全音推弦 + 颤音 ----------
\section "B · 全音推弦 + 颤音 {b (0 2)} {v}"
:8 7.3{b (0 2)} 7.3{v} 9.3{b (0 2)} 9.3{v} 7.3{b (0 2)} 7.3{v} 9.3{b (0 2)} 9.3{v} | :8 9.3{b (0 2)} 9.3{v} 7.3{b (0 2)} 7.3{v} 5.3{b (0 2)} 5.3{v} 5.3{b (0 2)} 5.3{v} | :8 7.4{b (0 2)} 7.4{v} 9.4{b (0 2)} 9.4{v} 7.4{b (0 2)} 7.4{v} 5.4{b (0 2)} 5.4{v} | :8 7.5{b (0 2)} 7.5{v} 10.5{b (0 2)} 10.5{v} 7.5{b (0 2)} 7.5{v} 5.5{b (0 2)} 5.5{v} |
// ---------- 9–12 · 预推弦与回放 ----------
\section "C · 预推弦与回放"
:8 9.3{b (0 2)} 9.3{b (2 0)} 7.3{b (0 2)} 7.3{b (2 0)} 9.3{b (0 2)} 9.3{b (2 0)} 7.3{b (0 2)} 7.3{b (2 0)} | :8 10.2{b (0 2)} 10.2{b (2 0)} 12.2{b (0 2)} 12.2{b (2 0)} 10.2{b (0 2)} 10.2{b (2 0)} 9.2{b (0 2)} 9.2{b (2 0)} | :8 12.1{b (0 2)} 12.1{b (2 0)} 12.1{b (0 2)} 12.1{b (2 0)} 12.2{b (0 2)} 12.2{b (2 0)} 12.2{b (0 2)} 12.2{b (2 0)} | :8 9.3{b (0 2)} 9.3 7.3{b (0 1)} 7.3 5.3{b (0 2)} 5.3 5.3{v} 5.3{v} |
// ---------- 13–16 · 实用乐句 ----------
\section "D · 实用乐句"
:8 12.1{v} 12.1 12.2{b (0 1)} 12.2 13.2{b (0 1)} 13.2 14.2{b (0 2)} 14.2{v} | :8 12.2{b (0 2)} 12.2{v} 10.2{b (0 2)} 10.2{v} 9.2{b (0 1)} 9.2 7.2{v} 7.2 | :8 12.1{b (0 2)} 12.1{v} 12.2{b (0 2)} 12.2{v} 12.3{b (0 2)} 12.3{v} 12.3{v} 12.3{v} | :4 12.1{b (0 2)}{v} :4 12.1{v} :2 0.6 |
